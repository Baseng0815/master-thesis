	keywords = {Computer Science - Artificial Intelligence, Computer Science - Cryptography and Security},
	file = {PDF:/home/bastian/Zotero/storage/7DPEH9CQ/Böttinger et al. - 2018 - Deep Reinforcement Fuzzing.pdf:application/pdf},
}

@misc{she_neuzz_2019,
	title = {{NEUZZ}: {Efficient} {Fuzzing} with {Neural} {Program} {Smoothing}},
	shorttitle = {{NEUZZ}},
	url = {http://arxiv.org/abs/1807.05620},
	doi = {10.48550/arXiv.1807.05620},
	abstract = {Fuzzing has become the de facto standard technique for ﬁnding software vulnerabilities. However, even state-of-theart fuzzers are not very efﬁcient at ﬁnding hard-to-trigger software bugs. Most popular fuzzers use evolutionary guidance to generate inputs that can trigger different bugs. Such evolutionary algorithms, while fast and simple to implement, often get stuck in fruitless sequences of random mutations. Gradient-guided optimization presents a promising alternative to evolutionary guidance. Gradient-guided techniques have been shown to signiﬁcantly outperform evolutionary algorithms at solving high-dimensional structured optimization problems in domains like machine learning by efﬁciently utilizing gradients or higher-order derivatives of the underlying function.},
	language = {en},
	urldate = {2025-11-05},
