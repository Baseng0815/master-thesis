	annote = {Comment: 99 pages, Accepted to Artificial Intelligence Review journal},
	file = {PDF:/home/bastian/Zotero/storage/WJ4SGNKZ/Świechowski et al. - 2023 - Monte Carlo Tree Search A Review of Recent Modifications and Applications.pdf:application/pdf},
