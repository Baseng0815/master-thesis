	month = apr,
	year = {2019},
	note = {arXiv:1812.00140 [cs.CR]},
	keywords = {Computer Science - Cryptography and Security, Computer Science - Software Engineering},
	annote = {Comment: 29 pages, under submission to ACM Computing Surveys (July 2018) - 2018.12.10 update: correct minor mistakes in overview table - 2019.02.16 update: source clean - 2019.04.08: submission to TSE, 21 pages},
	file = {PDF:/home/bastian/Zotero/storage/JTUP3KI3/Manes et al. - 2019 - The Art, Science, and Engineering of Fuzzing A Survey.pdf:application/pdf},
}

@article{marksteiner_learning_2025,
