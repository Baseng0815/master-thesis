	keywords = {Computer Science - Artificial Intelligence, Computer Science - Machine Learning},
	annote = {Comment: NeurIPS-2020},
	file = {PDF:/home/bastian/Zotero/storage/3SY9EDLC/Grimm et al. - 2020 - The Value Equivalence Principle for Model-Based Reinforcement Learning.pdf:application/pdf},
}

