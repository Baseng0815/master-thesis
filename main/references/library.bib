	pages = {1140--1144},
	file = {PDF:/home/bastian/Zotero/storage/SGYQFZEM/Silver et al. - 2018 - A general reinforcement learning algorithm that masters chess, shogi, and Go through self-play.pdf:application/pdf},
}

