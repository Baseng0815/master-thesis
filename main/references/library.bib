@incollection{thuraisingham_pulsar_2015,
	address = {Cham},
	title = {Pulsar: {Stateful} {Black}-{Box} {Fuzzing} of {Proprietary} {Network} {Protocols}},
	volume = {164},
	copyright = {http://www.springer.com/tdm},
	isbn = {978-3-319-28864-2 978-3-319-28865-9},
