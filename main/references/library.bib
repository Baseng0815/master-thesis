@article{schrittwieser_mastering_2020,
	title = {Mastering {Atari}, {Go}, {Chess} and {Shogi} by {Planning} with a {Learned} {Model}},
	volume = {588},
	issn = {0028-0836, 1476-4687},
	url = {http://arxiv.org/abs/1911.08265},
