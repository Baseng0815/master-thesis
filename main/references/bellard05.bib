
@article{bellard_qemu_2005,
	title = {{QEMU}, a {Fast} and {Portable} {Dynamic} {Translator}},
	abstract = {We present the internals of QEMU, a fast machine emulator using an original portable dynamic translator. It emulates several CPUs (x86, PowerPC, ARM and Sparc) on several hosts (x86, PowerPC, ARM, Sparc, Alpha and MIPS). QEMU supports full system emulation in which a complete and unmodiﬁed operating system is run in a virtual machine and Linux user mode emulation where a Linux process compiled for one target CPU can be run on another CPU.},
	language = {en},
	author = {Bellard, Fabrice},
	year = {2005},
	file = {PDF:/home/bastian/Zotero/storage/XTQZEDU2/Bellard - 2005 - QEMU, a Fast and Portable Dynamic Translator.pdf:application/pdf},
}
